    },
    {
      "tempo": 1.54,
      "fr": "J'ai vu des gens tendre les bras et leurs deux doigts levés",
      "pt": "Vi pessoas com os braços estendidos e os dois dedos levantados",
      "en": "I saw people with their arms outstretched and their two fingers raised"
    },
    {
      "tempo": 5.62,
      "fr": "Leurs majeurs et leurs index toujours en forme de V",
      "pt": "Seus dedos médio e indicador sempre em forma de V",
      "en": "Their middle and index fingers always in the shape of a V"
    },
    {
      "tempo": 9.13,
      "fr": "J'ai donc demandé ce que ce symbole, pouvait signifier",
      "pt": "Então perguntei o que esse símbolo poderia significar.",
      "en": "So I asked what this symbol could mean."
    },
    {
      "tempo": 12.81,
      "fr": "Et bien personne, au grand personne, n'a pu me l'expliquer",
      "pt": "Bem, ninguém, realmente, poderia explicar isso para mim",
      "en": "Well no one, really, could explain it to me"
    },
    {
