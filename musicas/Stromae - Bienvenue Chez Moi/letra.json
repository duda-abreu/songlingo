    },
    {
      "tempo": 9.06,
      "fr": "Ces quatre murs en plastique",
      "pt": "Estas quatro paredes de plástico",
      "en": "These four plastic walls"
    },
    {
      "tempo": 11.58,
      "fr": "Sont peints de papier et de tas de Bic",
      "pt": "São pintados com papel e pilhas de Bic",
      "en": "Are painted with paper and piles of Bic"
    },
    {
      "tempo": 13.33,
      "fr": "Des tas de feuilles à moitié mortes",
      "pt": "Pilhas de folhas meio mortas",
      "en": "Piles of half-dead leaves"
    },
    {
      "tempo": 15.52,
      "fr": "À moitié bourges ou à moitié fortes",
      "pt": "Meio burguês ou meio forte",
      "en": "Half bourgeois or half strong"
    },
    {
      "tempo": 17.34,
      "fr": "Un jour vertes, un jour brunes",
      "pt": "Um dia verde, um dia marrom",
      "en": "One day green, one day brown"
    },
    {
      "tempo": 19.68,
      "fr": "Noires, jaunes, rouges et un jour plumes",
      "pt": "Penas pretas, amarelas, vermelhas e de um dia",
      "en": "Black, yellow, red and one day feathers"
    },
    {
      "tempo": 21.03,
