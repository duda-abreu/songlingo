    {
      "tempo": 78.47,
      "fr": "Dans mes quatre murs, y'a des tas de choses",
      "pt": "Nas minhas quatro paredes há muitas coisas",
      "en": "In my four walls, there are lots of things"
    },
    {
      "tempo": 80.22,
      "fr": "Peu de livres mais des tas de proses",
      "pt": "Poucos livros, mas pilhas de prosa",
      "en": "Few books but piles of prose"
    },
    {
      "tempo": 81.69,
      "fr": "Trop de pensées pour si peu d'écrits",
      "pt": "Muitos pensamentos para tão pouco escrever",
      "en": "Too many thoughts for so little writing"
    },
    {
      "tempo": 83.36,
      "fr": "Et si peu de pays pour tellement de roses",
      "pt": "E tão poucos países para tantas rosas",
      "en": "And so few countries for so many roses"
    },
    {
      "tempo": 85.72,
      "fr": "Y'a des sales jaunes, des sales noirs",
      "pt": "Existem amarelos sujos, pretos sujos",
      "en": "There are dirty yellow ones, dirty black ones"
    },
    {
      "tempo": 88.24,
      "fr": "Des sales rouges et des sales blancs",
      "pt": "Vermelhos sujos e brancos sujos",
      "en": "Dirty reds and dirty whites"
    },
    {
      "tempo": 90.02,
      "fr": "Il y a surtout que de gros bâtards devenus rouge-sang",
      "pt": "Acima de tudo, existem apenas grandes bastardos que ficaram vermelhos como sangue",
      "en": "Above all, there are only big bastards who have turned blood red"
    },
    {
      "tempo": 93.07,
      "fr": "Bienvenue chez moi",
      "pt": "Bem-vindo à minha casa",
      "en": "Welcome to my home"
    },
    {
      "tempo": 95.69,
      "fr": "Comme moi, comme toi, comme nous",
      "pt": "Como eu, como você, como nós",
      "en": "Like me, like you, like us"
    },
    {
      "tempo": 96.99,
      "fr": "Des hommes-chiens devenus hommes-loups",
      "pt": "Homens-cachorros se tornam homens-lobos",
      "en": "Dogmen become wolfmen"
    },
    {
      "tempo": 98.8,
      "fr": "Des femmes-hyènes, voulant être belles",
      "pt": "Mulheres hienas, querendo ser lindas",
      "en": "Hyena women, wanting to be beautiful"
    },
    {
      "tempo": 100.42,
      "fr": "Et encore plus superbes à se rendre fous",
      "pt": "E ainda mais soberbo para deixar um ao outro louco",
      "en": "And even more superb to drive each other crazy"
    },
    {
      "tempo": 102.74,
      "fr": "À se rendre folles, à se rendre connes",
      "pt": "Para deixar um ao outro louco, para deixar um ao outro estúpido",
      "en": "To make each other crazy, to make each other stupid"
    },
    {
      "tempo": 104.89,
      "fr": "À se vendre bonnes, à faire toutes comme",
      "pt": "Vender-se bem, fazer tudo como",
      "en": "To sell oneself good, to do everything as"
    },
    {
      "tempo": 107.26,
