      "en": "Welcome to my home"
    },
    {
      "tempo": 25.64,
      "fr": "D'humeur vénère, d'humeur sainte",
      "pt": "Num clima de adoração, num clima santo",
      "en": "In a worshipful mood, in a holy mood"
    },
    {
      "tempo": 27.69,
      "fr": "Mais aussi vraies donc vulgaires",
      "pt": "Mas também verdadeiro e, portanto, vulgar",
      "en": "But also true and therefore vulgar"
    },
