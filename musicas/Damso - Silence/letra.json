{
  "titulo": "Silence",
  "artista": "Damso",
  "arquivo_audio": "audio.mp3",
  "linhas": [
    {
      "tempo": 7.04,
      "fr": "Ouais",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 10.39,
      "fr": "Oh ouais",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 13.39,
      "fr": "Eh, ouais",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 15.75,
      "fr": "Silence, je ne parle pas",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 17.84,
      "fr": "Écoute c'que j'ai à dire quand je parle de toi",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 20.01,
      "fr": "J'veux qu'tu me devines, que tu meurs de moi",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 22.23,
      "fr": "Viens dans ma tête, ne dis plus un mot",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 26.26,
      "fr": "Je serai ton paradis, si l'enfer est l'autre",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 31.05,
      "fr": "Hey",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 32.05,
      "fr": "Vous les femmes, c'est toujours pareil",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 33.5,
      "fr": "Quand le drame s'abat, vous pleurez",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 34.96,
      "fr": "Vous les hommes, c'est toujours pareil",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 36.3,
      "fr": "Quand le drame s'abat, vous courez",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 37.99,
      "fr": "C'est pour ça qu'les relations s'arrêtent",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 39.26,
      "fr": "J'ai tort, c'est ma faute",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 41.48,
      "fr": "Sentiments égarés",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 42.57,
      "fr": "On sourit pour ne pas pleurer",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 44.02,
      "fr": "On s'oublie pour ne plus s'aimer",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 45.52,
      "fr": "Cherche la perfection pour fuir la réalité",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 47.67,
      "fr": "Le vrai problème, c'est qu'à chaque fois qu'c'est le même problème",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 49.96,
      "fr": "Chatouilles de bijoux, pardonner",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 51.64,
      "fr": "Entraînent bisous empoisonné",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 53.16,
      "fr": "Précède un \"je t'aime\" qui n'a pas oublié",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 55.21,
      "fr": "Que t'as aimé un autre",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 58.96,
      "fr": "C'est la tienne ou ma faute?",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 80.18,
      "fr": "Ta vérité n'est pas la mienne",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 88.36,
      "fr": "Ta vérité n'est pas la mienne",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 96.45,
      "fr": "Ta vérité n'est pas la mienne",
      "pt": "",
      "en": ""
    },
    {
      "tempo": 100.13,
      "fr": "Car je tombe, et puis, c'est moi qui traîne",
      "pt": "",
      "en": ""
    }
  ],
