{
  "titulo": "J'ai vu",
  "artista": "Roméo Elvis",
  "arquivo_audio": "audio.mp3",
  "linhas": [
    {
      "tempo": 53.03,
      "fr": "J'suis posé dans un canap' roule hashish",
      "pt": "Estou deitado no sofá, enrolando haxixe",
      "en": "I'm lying on a sofa, rolling hashish"
    },
    {
      "tempo": 55.35,
      "fr": "Télé full H.D, tout le monde est assis",
      "pt": "TV Full HD, todos estão sentados",
      "en": "Full HD TV, everyone is seated"
    },
    {
      "tempo": 58.23,
      "fr": "J'regarde la télé et j'me rends compte que la vie ça file",
      "pt": "Eu assisto TV e percebo que a vida está voando",
      "en": "I watch TV and I realize that life is flying by"
    },
    {
      "tempo": 61.29,
      "fr": "Un jour j'aurai des gosses faudra protéger ma fille (sa fille)",
      "pt": "Um dia terei filhos terei que proteger minha filha (a filha dele)",
      "en": "One day I will have kids I will have to protect my daughter (his daughter)"
    },
    {
      "tempo": 64.59,
      "fr": "Ma sœur a mis sa voix sur la prod' ça me calme",
      "pt": "Minha irmã colocou a voz na produção, isso me acalma",
      "en": "My sister put her voice on the production, it calms me down"
    },
    {
      "tempo": 68.99,
      "fr": "Papa écoute le son avec le sourire",
      "pt": "Papai ouve o som com um sorriso",
      "en": "Dad listens to the sound with a smile"
    },
    {
      "tempo": 71.46,
      "fr": "Maman écoute le son avec le casque et le mal s'évapore",
      "pt": "Mamãe ouve o som com fones de ouvido e o mal evapora",
      "en": "Mom listens to the sound with headphones and the evil evaporates"
    },
    {
      "tempo": 85.27,
      "fr": "Ça n'en vaut pas la peine, non",
      "pt": "Não vale a pena, não",
      "en": "It's not worth it, no"
    },
    {
      "tempo": 87.94,
      "fr": "Il faudra s'y faire",
      "pt": "Você vai ter que se acostumar",
      "en": "You'll have to get used to it"
    },
    {
      "tempo": 90.65,
      "fr": "Ça n'en vaut pas la peine",
      "pt": "Não vale a pena",
      "en": "It's not worth it"
    },
    {
      "tempo": 93.24,
      "fr": "Non, il faudra s'y faire",
      "pt": "Não, você terá que se acostumar",
      "en": "No, you'll have to get used to it"
    },
    {
      "tempo": 95.83,
      "fr": "J'ai, j'ai vu dans ma tête",
      "pt": "Eu, eu vi na minha cabeça",
      "en": "I, I saw in my head"
    },
    {
      "tempo": 106.07,
      "fr": "Qu'on allait se fâcher",
      "pt": "Que íamos ficar com raiva",
      "en": "That we were going to get angry"
    },
    {
      "tempo": 108.69,
      "fr": "Qu'on allait se lâcher tout en laissant faire",
      "pt": "Que íamos deixar ir enquanto deixávamos acontecer",
      "en": "That we were going to let go while letting it happen"
    },
    {
      "tempo": 111.4,
      "fr": "Ce qu'on voulait pourtant cacher",
      "pt": "O que queríamos esconder",
      "en": "What we wanted to hide"
    },
    {
      "tempo": 113.84,
      "fr": "Chérie s'il fallait se taire alors j'ai vraiment tout gâché",
      "pt": "Querida, se você tivesse que ficar quieto, eu realmente estraguei tudo",
      "en": "Honey if you had to keep quiet then I really ruined everything"
    },
    {
      "tempo": 117.2,
      "fr": "J'ai-j'aimerai que tu cèdes",
      "pt": "Eu-eu gostaria que você cedesse",
      "en": "I-I wish you would give in"
    },
    {
      "tempo": 127.38,
      "fr": "À mes propositions, éloignons-nous d'ici",
      "pt": "Por minha sugestão, vamos sair daqui",
      "en": "At my suggestion, let's get away from here"
    },
    {
      "tempo": 130.37,
      "fr": "Prends ça comme une mission, devenons invisibles",
      "pt": "Tome isso como uma missão, vamos nos tornar invisíveis",
      "en": "Take this as a mission, let's become invisible"
    },
    {
      "tempo": 132.88,
      "fr": "Je lui ai dit \"à tout à l'heure\"",
      "pt": "Eu disse a ele “até logo”",
      "en": "I told him “see you later”"
    },
    {
