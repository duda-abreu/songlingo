{
  "titulo": "Le temps fera les choses",
  "artista": "Angèle",
  "arquivo_audio": "audio.mp3",
  "linhas": [
    {
      "tempo": 7.87,
      "fr": "Toujours faire semblant",
      "pt": "Sempre finja",
      "en": "Always pretend"
    },
    {
      "tempo": 9.95,
      "fr": "Quand on me parle de nous évidemment",
      "pt": "Quando as pessoas falam comigo sobre nós, obviamente",
      "en": "When people talk to me about us obviously"
    },
    {
      "tempo": 13.2,
      "fr": "Avancer sans toi",
      "pt": "Seguindo em frente sem você",
      "en": "Moving forward without you"
    },
    {
      "tempo": 15.39,
      "fr": "Et me dire que tout ça reviendra",
      "pt": "E me diga que tudo vai voltar",
      "en": "And tell me that it will all come back"
    },
    {
      "tempo": 18.54,
      "fr": "Réouvrir les plaies",
      "pt": "Reabra as feridas",
      "en": "Reopen the wounds"
    },
    {
      "tempo": 20.31,
      "fr": "En essayant de retrouver le passé",
      "pt": "Tentando redescobrir o passado",
      "en": "Trying to rediscover the past"
    },
    {
      "tempo": 23.67,
      "fr": "Et puis vouloir oublier",
      "pt": "E então quero esquecer",
      "en": "And then want to forget"
    },
    {
      "tempo": 26.29,
      "fr": "Et tout refermer",
      "pt": "E feche tudo",
      "en": "And close everything"
    },
    {
      "tempo": 28.67,
      "fr": "Oh y'a des jours je te jure sur mes joues",
      "pt": "Oh, há dias em que juro pelas minhas bochechas",
      "en": "Oh there are days I swear to you on my cheeks"
    },
    {
      "tempo": 31.39,
      "fr": "Mes larmes coulent j'en perds les mots",
      "pt": "Minhas lágrimas fluem, eu perco as palavras",
      "en": "My tears flow, I lose the words"
    },
    {
      "tempo": 34.55,
      "fr": "Y'a des jours je te jure que je joue",
      "pt": "Tem dias que eu juro que jogo",
      "en": "There are days I swear to you that I play"
    },
    {
      "tempo": 36.91,
      "fr": "Sans toi comme si c'était nouveau",
      "pt": "Sem você como se fosse novo",
      "en": "Without you as if it were new"
    },
    {
      "tempo": 39.61,
      "fr": "Mais y'a des jours je t'attends et j'avoue",
      "pt": "Mas tem dias que espero por você e confesso",
      "en": "But there are days I wait for you and I confess"
    },
    {
      "tempo": 42.09,
      "fr": "Que tout est de plus en plus lourd",
      "pt": "Que tudo está ficando cada vez mais pesado",
      "en": "That everything is getting heavier and heavier"
    },
    {
      "tempo": 44.91,
      "fr": "J'aimerais parfois faire demi-tour",
      "pt": "Às vezes eu gostaria de me virar",
      "en": "Sometimes I would like to turn around"
    },
    {
      "tempo": 49.22,
      "fr": "Le temps fera les choses",
      "pt": "O tempo fará coisas",
      "en": "Time will do things"
    },
    {
      "tempo": 54.51,
      "fr": "On verra si on ose",
      "pt": "",
      "en": "We'll see if we dare"
    },
    {
      "tempo": 60.23,
      "fr": "Perdre nos raisons",
      "pt": "Perdendo nossas razões",
      "en": ""
    },
    {
      "tempo": 62.66,
      "fr": "Pour retrouver la maison",
      "pt": "Para encontrar casa",
      "en": "To find home"
    },
    {
      "tempo": 65.21,
      "fr": "Mais le temps fera les choses",
      "pt": "Mas o tempo fará as coisas",
      "en": "But time will do things"
    },
    {
      "tempo": 68.72,
      "fr": "Tu me l'as dit",
      "pt": "Você me disse",
      "en": "You told me"
    },
    {
      "tempo": 72.43,
      "fr": "Si on veut on peut dire que c'était mieux avant",
      "pt": "Se quisermos podemos dizer que antes era melhor",
      "en": "If we want we can say that it was better before"
    },
    {
      "tempo": 74.86,
      "fr": "Si on veut on peut encore s'éviter longtemps",
      "pt": "Se quisermos ainda podemos nos evitar por muito tempo",
      "en": "If we want we can still avoid each other for a long time"
    },
    {
      "tempo": 77.52,
      "fr": "Un éternité qu'on s'aime et on se hait",
      "pt": "Uma eternidade que nos amamos e nos odiamos",
      "en": "An eternity that we love and hate each other"
    },
    {
      "tempo": 80.56,
      "fr": "Mais on le sait",
      "pt": "Mas nós sabemos disso",
      "en": "But we know it"
    },
    {
      "tempo": 81.8,
      "fr": "Tout ne tenait qu'à un fil",
