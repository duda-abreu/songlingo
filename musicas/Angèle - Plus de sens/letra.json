    {
      "tempo": 8.94,
      "fr": "Comme la météo en novembre",
      "pt": "Como o clima em novembro",
      "en": "Like the weather in November"
    },
    {
      "tempo": 13.08,
      "fr": "Comme une étincelle dans une pompe à essence",
