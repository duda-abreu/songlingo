  "linhas": [
    {
      "tempo": 10.19,
      "fr": "Ma journée est passée à une de ces vitesses (quoi?)",
      "pt": "Meu dia passou em uma dessas velocidades (o quê?)",
      "en": "My day went by in one of those speeds (what?)"
    },
    {
      "tempo": 14.73,
      "fr": "Pas mis le nez dehors et pas lavée (oh)",
      "pt": "Não coloquei os pés lá fora e não lavei (oh)",
      "en": "Not set foot outside and not washed (oh)"
    },
    {
      "tempo": 17.88,
      "fr": "Ah ça je déteste",
      "pt": "Ah, isso eu odeio",
      "en": "Oh that I hate"
    },
    {
      "tempo": 19.61,
      "fr": "Batterie faible, j'ai pas de quoi recharger (oh non)",
      "pt": "Bateria fraca, não tenho nada para recarregar (ah, não)",
      "en": "Low battery, I don't have anything to recharge (oh no)"
    },
    {
      "tempo": 22.66,
      "fr": "Et ça n'arrive qu'à moi",
      "pt": "E isso só acontece comigo",
      "en": "And it only happens to me"
    },
    {
      "tempo": 24.35,
      "fr": "J'voulais faire des stories qui t'étaient dédiées",
      "pt": "Eu queria fazer histórias dedicadas a você",
      "en": "I wanted to make stories dedicated to you"
    },
    {
      "tempo": 27.26,
      "fr": "J'sais pas te dire pourquoi",
      "pt": "Eu não sei por que",
      "en": "I don't know why"
    },
    {
      "tempo": 29.72,
      "fr": "Regarde comment je souris",
      "pt": "Olha como eu sorrio",
      "en": "Look how I smile"
    },
    {
      "tempo": 32.65,
      "fr": "Regardez encore",
      "pt": "Olhe novamente",
      "en": "Look again"
    },
    {
      "tempo": 34.53,
      "fr": "Je veux savoir ce que t'en dis",
      "pt": "Eu quero saber o que você diz",
      "en": "I want to know what you say"
    },
    {
      "tempo": 37.62,
      "fr": "Quand j'souris trop fort",
      "pt": "Quando eu sorrio muito",
      "en": "When I smile too hard"
    },
    {
