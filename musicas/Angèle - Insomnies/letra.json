  "linhas": [
    {
      "tempo": 3.76,
      "fr": "J'ai pas vu venir la nuit ni les ombres qui passent",
      "pt": "Eu não vi a noite chegando ou as sombras que passavam",
      "en": "I didn't see the night coming or the passing shadows"
    },
    {
      "tempo": 8.22,
      "fr": "On m'a dit que celle-ci porte conseil",
      "pt": "Me disseram que este dá conselhos",
      "en": "I was told that this one gives advice"
    },
    {
      "tempo": 11.35,
      "fr": "Si seulement je dormais",
      "pt": "Se ao menos eu dormisse",
      "en": "If only I slept"
    },
    {
      "tempo": 15.75,
      "fr": "4 heures du matin, cette musique me dit rien",
      "pt": "4 da manhã, essa música não significa nada para mim",
      "en": "4 a.m., this music means nothing to me"
    },
    {
      "tempo": 19.38,
      "fr": "Et je ferme les yeux, on est déjà demain",
      "pt": "E fecho os olhos, já é amanhã",
      "en": "And I close my eyes, it's already tomorrow"
    },
    {
      "tempo": 23.28,
      "fr": "J'ai essayé en vain",
      "pt": "Eu tentei em vão",
      "en": "I tried in vain"
    },
    {
      "tempo": 31.86,
      "fr": "À trop attendre le sommeil",
      "pt": "Esperando muito para dormir",
      "en": "Waiting too long for sleep"
    },
    {
      "tempo": 34.57,
      "fr": "Je fatigue",
      "pt": "Estou cansado",
      "en": "I'm tired"
    },
    {
      "tempo": 35.66,
      "fr": "La nuit blanche m'offre ses pensées noires",
      "pt": "A noite branca me oferece seus pensamentos negros",
      "en": "The white night offers me its black thoughts"
    },
    {
      "tempo": 38.73,
      "fr": "Et le vide occulté",
      "pt": "E o vazio oculto",
      "en": "And the hidden void"
    },
    {
      "tempo": 40.41,
      "fr": "En plein jour éclairé, en pleine nuit",
      "pt": "Em plena luz do dia, no meio da noite",
      "en": "In broad daylight, in the middle of the night"
    },
    {
      "tempo": 43.75,
      "fr": "Insomnie, insomnie",
      "pt": "Insônia, insônia",
      "en": "Insomnia, insomnia"
    },
    {
      "tempo": 51.55,
      "fr": "Insomnie, la ville dort",
      "pt": "Insônia, a cidade dorme",
      "en": "Insomnia, the city sleeps"
    },
    {
      "tempo": 53.59,
      "fr": "J'vois les ombres comme des corps",
      "pt": "Eu vejo sombras como corpos",
      "en": "I see shadows like bodies"
    },
    {
      "tempo": 59.56,
      "fr": "Insomnie, comme des corps",
      "pt": "Insônia, como corpos",
      "en": "Insomnia, like bodies"
    },
    {
      "tempo": 61.69,
      "fr": "Et d'ici tout semble mort",
      "pt": "E daqui tudo parece morto",
      "en": "And from here everything seems dead"
    },
    {
      "tempo": 63.63,
      "fr": "Ce soir j'suis pas là, j'suis partie",
      "pt": "Esta noite não estou aqui, fui embora",
      "en": "This evening I'm not here, I left"
    },
    {
      "tempo": 66.19,
      "fr": "J'me balade et j'ai froid",
      "pt": "Eu ando por aí e estou com frio",
      "en": "I walk around and I'm cold"
    },
    {
      "tempo": 68.34,
      "fr": "Dans Paris, sa magie, ses angoisses",
      "pt": "Em Paris, sua magia, suas ansiedades",
      "en": "In Paris, its magic, its anxieties"
    },
    {
      "tempo": 71.38,
      "fr": "À quelques larmes de toi",
      "pt": "Algumas lágrimas suas",
      "en": "A few tears from you"
    },
    {
      "tempo": 75.66,
      "fr": "J'me dis que c'était pas lui, que c'était pas moi",
      "pt": "Digo a mim mesmo que não foi ele, que não fui eu",
      "en": "I tell myself that it wasn't him, that it wasn't me"
    },
    {
      "tempo": 78.23,
      "fr": "Le ciel gris, les orages",
